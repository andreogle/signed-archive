/node_modules/

# The archive itself. Large and regenerable only from the day you start, so back it up rather than commit it.
/data/

# Native binary from `bun run build`.
/dist/

# Cache from the impeccable design plugin.
/.impeccable/

# Local compose settings; may hold the heartbeat URL token.
/.env

# Foundry build output for proofs/.
/proofs/out/
/proofs/cache/

