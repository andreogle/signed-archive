{
  "name": "signed-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "airnodes": "bun scripts/airnodes.ts",
    "build": "bun build src/cli.ts --compile --minify --sourcemap --bytecode --format=esm --outfile dist/signed-archive",
    "check": "bun scripts/airnodes.ts --check && biome check . && tsc --noEmit && bun run test",
    "dev": "bun --watch src/cli.ts archive --serve",
    "format": "biome check --write .",
    "lint": "biome check .",
    "serve": "NODE_ENV=production bun src/cli.ts serve",
    "start": "bun src/cli.ts",
    "test": "bun test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "commander": "15.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.12"
  },
  "devDependencies": {
    "@api3/api-integrations": "22.8.0",
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
